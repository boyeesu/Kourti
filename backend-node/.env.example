# ============================================
# Kourti backend (Node) — environment example
# ============================================
# Set these in your deployment platform (Railway). Never commit a real .env.
# This file documents the backend vars; the repo-root .env.example covers the
# frontend (VITE_*) build vars.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
AUTH_MODE="custom"          # "custom" = JWT (prod); "development" = local only
PORT=4000
APP_URL="https://app.kourti.com"
CORS_ORIGINS="http://localhost:5173,https://app.kourti.com,https://kourti.com"

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# ── JWT (required when AUTH_MODE=custom) ───────────────────────────────────
# Both MUST be distinct, 32+ random chars in production.
JWT_SECRET="change-me-32+-random-chars"
JWT_REFRESH_SECRET="change-me-DIFFERENT-32+-random-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Dedicated HMAC keys (OPTIONAL — segregated from JWT_SECRET) ─────────────
# Each isolates one signing use so a single leak doesn't widen the blast radius
# (VAPT Low — crypto key reuse). When UNSET, the code falls back to JWT_SECRET
# so already-issued signed file URLs and live unsubscribe links keep verifying.
# Set dedicated 32+ byte values in production and rotate independently of JWT.
#   SIGNED_URL_SECRET        — HMAC key for backend-issued signed file URLs.
#   UNSUBSCRIBE_HMAC_SECRET  — HMAC key for one-click marketing unsubscribe tokens.
# SIGNED_URL_SECRET="change-me-32+-random-chars"
# UNSUBSCRIBE_HMAC_SECRET="change-me-32+-random-chars"

# Dedicated symmetric key for application-layer field encryption (e.g. TOTP
# secrets at rest). OPTIONAL: falls back to a JWT_SECRET-derived key. A dedicated
# 32+ byte key is strongly recommended in production.
# APP_ENCRYPTION_KEY="change-me-32+-random-chars"

# SSO client-secret encryption key. MUST be changed from the default outside
# local development (the boot guard fires on any non-development NODE_ENV).
SSO_SECRET_KEY="change-me-32+-random-chars"

# ── AI providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-key"
# ANTHROPIC_API_KEY="sk-ant-your-key"
# OPENROUTER_API_KEY="sk-or-v1-your-key"
LLM_PRIMARY_PROVIDER="openrouter"   # anthropic | openai | openrouter

# ── Marketing chatbot KB (MARTHA) ──────────────────────────────────────────
# Optional shared secret for the manual KB push endpoint (POST /api/v1/public/kb/sync).
# If unset, that endpoint returns 503. Compared in constant time server-side.
# KB_SYNC_SECRET="change-me-random-secret"
# Public JSON of marketing site copy the nightly sync fetches + re-embeds.
# MUST be https on an allowlisted host (*.kourti.com or *.vercel.app); private,
# loopback and link-local hosts are rejected, and the body is capped at 5 MB.
# MARKETING_KB_URL="https://kourti.com/kb-content.json"
# MARKETING_KB_SYNC_CRON="0 3 * * *"

# ── Email (Resend transactional) ────────────────────────────────────────────
RESEND_API_KEY="re-your-resend-key"
SMTP_FROM_EMAIL="noreply@kourti.com"
# Base URL the unsubscribe link points at (falls back to APP_URL).
# PUBLIC_BASE_URL="https://app.kourti.com"

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# PAYSTACK_SECRET_KEY="sk_live_xxx"
# PAYSTACK_CURRENCY="NGN"

# ── File storage ────────────────────────────────────────────────────────────
STORAGE_DRIVER="fs"          # "fs" = local volume; "s3"/"r2" = object storage
STORAGE_PATH="/app/storage"
# Optional migration bridge: when true and STORAGE_DRIVER is s3/r2, reads can
# fall back to the old filesystem if an object is missing in bucket storage.
# Turn off after backfill verification.
# STORAGE_READ_FALLBACK_FS="false"

# S3-compatible vars (required when STORAGE_DRIVER=s3|r2):
# S3_ENDPOINT="https://..."
# S3_BUCKET="kourti"
# S3_ACCESS_KEY="..."
# S3_SECRET_KEY="..."

# Cloudflare R2 aliases (you can set these instead of S3_*):
# R2_ACCOUNT_ID="<cloudflare-account-id>"
# R2_BUCKET="kourti-prod-files"
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."

# ── Antivirus (ClamAV) ──────────────────────────────────────────────────────
# CLAMAV_HOST="clamav"
# CLAMAV_PORT=3310
# CLAMAV_MODE="enforce"        # "enforce" rejects infected uploads; "warn" logs only

# ── Setup ───────────────────────────────────────────────────────────────────
# 1. Copy: cp backend-node/.env.example backend-node/.env
# 2. Use NON-production secrets for local dev; keep prod secrets only in Railway.
# 3. Never point a local DATABASE_URL at the production DB.
