# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ============================================
# These variables are embedded at build time and accessible in browser
# Prefix all frontend variables with VITE_

# Optional: Application Configuration
VITE_APP_URL="http://localhost:5173"
VITE_API_TIMEOUT=30000
VITE_APP_VERSION="1.0.0"

# Node backend configuration
VITE_USE_NODE_BACKEND="true"
VITE_BACKEND_API_URL="http://localhost:4000"

# Optional: Logging
VITE_LOG_API_ENDPOINT=""

# ============================================
# SECURITY WARNING
# ============================================
# ❌ DO NOT put sensitive API keys in VITE_ variables
# ❌ They will be exposed in the browser bundle
# ✅ Put all API keys in backend environment variables instead

# ❌ NEVER USE THESE (kept for reference only):
# VITE_OPENAI_API_KEY=""  # INSECURE - use Node backend
# VITE_DOCUMENSO_API_KEY=""  # INSECURE - use backend integration

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Copy the separate server template:
#      cp backend-node/.env.example backend-node/.env
# 3. Never put a secret in this file. All VITE_* values are embedded in the
#    browser bundle at build time.
# 4. See backend-node/.env.example for database, auth, AI, email, storage,
#    payment, and server-side security settings.
#
# See docs/ENVIRONMENT.md for the complete environment reference.
