# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ============================================
# These variables are embedded at build time and accessible in browser
# Prefix all frontend variables with VITE_

# Required: Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"

# Optional: Application Configuration
VITE_APP_URL="http://localhost:5173"
VITE_API_TIMEOUT=30000
VITE_APP_VERSION="1.0.0"

# Optional: Node backend migration flags
VITE_USE_NODE_BACKEND="false"
VITE_BACKEND_API_URL="http://localhost:4000"

# Optional: Logging
VITE_LOG_API_ENDPOINT=""

# ============================================
# SECURITY WARNING
# ============================================
# ❌ DO NOT put sensitive API keys in VITE_ variables
# ❌ They will be exposed in the browser bundle
# ✅ Put all API keys in Supabase Edge Function Secrets instead

# ❌ NEVER USE THESE (kept for reference only):
# VITE_OPENAI_API_KEY=""  # INSECURE - use Supabase Edge Functions
# VITE_DOCUMENSO_API_KEY=""  # INSECURE - use backend integration

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Set these in Supabase Dashboard → Edge Functions → Secrets
# NOT in this .env file (unless testing locally)

# Backend variables reference (set in Supabase, not here):
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# OPENAI_API_KEY="sk-your-openai-key"
# RESEND_API_KEY="re-your-resend-key"
# SSO_SECRET_KEY="your-32-byte-secret"
# SSO_ALLOWED_REDIRECT_ORIGINS="https://app.kourti.com,http://localhost:5173"
# APP_URL="https://app.kourti.com"
# FLUTTERWAVE_SECRET_KEY="FLWSECK-xxxxxxxxxxxxxxxx-X"
# FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxxxxx-X"
# FLUTTERWAVE_WEBHOOK_HASH="your-custom-webhook-hash"
# FLUTTERWAVE_ENCRYPTION_KEY="your-encryption-key"

# Node backend variables (for backend-node service on Railway)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
#   → On Railway: use your Supabase connection string (pooler mode recommended)
#     e.g. postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# CORS_ORIGINS="http://localhost:5173,https://app.kourti.com"
#   → On Railway: set to your Vercel frontend URL(s)
# AUTH_MODE="supabase"
#   → Use "supabase" for production, "development" for local dev
# APP_URL="https://app.kourti.com"
#   → Your frontend URL, used for CORS fallback
# NODE_ENV="production"
# PORT=4000
#   → Railway injects PORT automatically, no need to set manually

# ============================================
# FLUTTERWAVE (Frontend - non-sensitive)
# ============================================
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxxxxx-X"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY
# 3. Get values from Supabase Dashboard → Settings → API
# 4. Configure backend secrets in Supabase Dashboard
# 5. Never commit .env to version control
#
# See docs/ENVIRONMENT.md for detailed documentation


