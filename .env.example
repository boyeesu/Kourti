# ============================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# ============================================
# These variables are embedded at build time and accessible in browser
# Prefix all frontend variables with VITE_

# Optional: Application Configuration
VITE_APP_URL="http://localhost:5173"
VITE_API_TIMEOUT=30000
VITE_APP_VERSION="1.0.0"

# Node backend configuration
VITE_USE_NODE_BACKEND="true"
VITE_BACKEND_API_URL="http://localhost:4000"

# Optional: Logging
VITE_LOG_API_ENDPOINT=""

# ============================================
# SECURITY WARNING
# ============================================
# ❌ DO NOT put sensitive API keys in VITE_ variables
# ❌ They will be exposed in the browser bundle
# ✅ Put all API keys in backend environment variables instead

# ❌ NEVER USE THESE (kept for reference only):
# VITE_OPENAI_API_KEY=""  # INSECURE - use Node backend
# VITE_DOCUMENSO_API_KEY=""  # INSECURE - use backend integration

# ============================================
# BACKEND ENVIRONMENT VARIABLES (Node)
# ============================================
# Set these in your deployment platform (Railway, Docker, etc.)

# Required: Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Authentication
AUTH_MODE="custom"
#   → Use "custom" for production (JWT), "development" for local dev
JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"

# Server
PORT=4000
NODE_ENV="production"
APP_URL="https://app.kourti.com"
CORS_ORIGINS="http://localhost:5173,https://app.kourti.com"

# AI Integration
OPENAI_API_KEY="sk-your-openai-key"
OPENAI_CHAT_MODEL="gpt-4o"
OPENAI_FALLBACK_CHAT_MODEL="gpt-4o"

# Anthropic (direct)
# ANTHROPIC_API_KEY="sk-ant-your-key"
# ANTHROPIC_CHAT_MODEL="claude-opus-4-6"

# OpenRouter (gateway to Claude / GPT / Llama / Gemini / etc.)
# OPENROUTER_API_KEY="sk-or-v1-your-key"
# OPENROUTER_CHAT_MODEL="anthropic/claude-opus-4"
# OPENROUTER_FALLBACK_CHAT_MODEL="openai/gpt-5-mini"
# OPENROUTER_APP_NAME="Kourti Legal"

# Primary LLM provider: anthropic | openai | openrouter
# LLM_PRIMARY_PROVIDER="anthropic"

# Email (Resend)
RESEND_API_KEY="re-your-resend-key"
SMTP_FROM_EMAIL="noreply@kourti.com"

# Development defaults (only used when AUTH_MODE=development)
DEV_DEFAULT_USER_ID="00000000-0000-0000-0000-000000000001"
DEV_DEFAULT_ORG_ID="00000000-0000-0000-0000-000000000001"

# ============================================
# FLUTTERWAVE (Frontend - non-sensitive)
# ============================================
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxxxxx-X"

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in DATABASE_URL for your Postgres instance
# 3. Set JWT_SECRET and JWT_REFRESH_SECRET
# 4. Configure backend secrets for your deployment platform
# 5. Never commit .env to version control
#
# See docs/ENVIRONMENT.md for detailed documentation
